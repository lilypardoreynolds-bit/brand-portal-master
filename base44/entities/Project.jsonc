{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Active",
        "On Hold",
        "Completed",
        "Cancelled"
      ],
      "default": "Planning"
    },
    "color": {
      "type": "string",
      "default": "#6366f1"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_name"
  ]
}