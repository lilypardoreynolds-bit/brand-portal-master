{
  "name": "CommissionInvoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice ID"
    },
    "reporting_period": {
      "type": "string",
      "description": "Month and year"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "gross_sales": {
      "type": "number",
      "default": 0
    },
    "commission_rate": {
      "type": "number",
      "default": 0,
      "description": "Commission rate applied (%)"
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "payment_due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Issued",
        "Paid",
        "Overdue"
      ],
      "default": "Draft"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "reporting_period",
    "gross_sales",
    "commission_rate"
  ]
}