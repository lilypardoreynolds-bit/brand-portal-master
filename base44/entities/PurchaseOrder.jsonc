{
  "name": "PurchaseOrder",
  "properties": {
    "carrier": {
      "type": "string"
    },
    "documents": {
      "description": "Documents related to this purchase (invoices, packing lists, receipts, quotes) stored privately",
      "items": {
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "expected_delivery": {
      "format": "date",
      "type": "string"
    },
    "import_duties": {
      "default": 0,
      "type": "number"
    },
    "inspection_cost": {
      "default": 0,
      "description": "Quality inspection cost allocated across products",
      "type": "number"
    },
    "line_items": {
      "description": "List of products in this PO",
      "items": {
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "default": 0,
            "type": "number"
          },
          "unit_price": {
            "default": 0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": "string"
    },
    "order_date": {
      "format": "date",
      "type": "string"
    },
    "other_fees": {
      "default": 0,
      "type": "number"
    },
    "packaging_cost": {
      "default": 0,
      "description": "Packaging cost allocated across products",
      "type": "number"
    },
    "payment_date": {
      "format": "date",
      "type": "string"
    },
    "po_number": {
      "description": "Purchase Order number",
      "type": "string"
    },
    "prep_handling_cost": {
      "default": 0,
      "description": "Prep / handling cost allocated across products",
      "type": "number"
    },
    "product_id": {
      "description": "Primary product ID (for backward compat)",
      "type": "string"
    },
    "product_name": {
      "description": "Primary product name (for backward compat)",
      "type": "string"
    },
    "quantity": {
      "default": 0,
      "description": "Total quantity (for backward compat)",
      "type": "number"
    },
    "shipping_cost": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "Draft",
      "enum": [
        "Draft",
        "Ordered",
        "Paid",
        "In Transit",
        "Delivered",
        "Cancelled"
      ],
      "type": "string"
    },
    "supplier_id": {
      "description": "Linked supplier ID",
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "total_amount": {
      "default": 0,
      "description": "Total PO cost",
      "type": "number"
    },
    "tracking_number": {
      "type": "string"
    },
    "unit_price": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "order_date"
  ],
  "type": "object"
}