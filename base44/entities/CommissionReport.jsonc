{
  "name": "CommissionReport",
  "type": "object",
  "properties": {
    "reporting_period": {
      "type": "string",
      "description": "Month and year (e.g., 'March 2026')"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "total_gross_sales": {
      "type": "number",
      "default": 0
    },
    "commission_rate": {
      "type": "number",
      "default": 0,
      "description": "Commission rate applied (%)"
    },
    "total_commission_due": {
      "type": "number",
      "default": 0
    },
    "payment_due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Generated",
        "Invoiced",
        "Paid"
      ],
      "default": "Generated"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "reporting_period",
    "period_start",
    "period_end"
  ]
}