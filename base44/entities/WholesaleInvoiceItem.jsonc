{
  "name": "WholesaleInvoiceItem",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Discount percentage"
    },
    "line_total": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "invoice_id",
    "product_name",
    "quantity",
    "unit_price"
  ]
}