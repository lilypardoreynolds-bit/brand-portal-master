{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "viewer"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of page/section keys this user is allowed to access. Admins and viewers always have full access. Users need explicit permissions."
    }
  },
  "required": [
    "role"
  ]
}