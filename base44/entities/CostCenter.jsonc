{
  "name": "CostCenter",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Linked Product ID"
    },
    "product_name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "investment",
        "expense"
      ],
      "default": "investment",
      "description": "investment = product cost (freight, customs, packaging); expense = operational cost (FBA fees, ads)"
    },
    "category": {
      "type": "string",
      "description": "e.g. Freight, Customs, FBA Fees, Packaging"
    },
    "description": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "po_number": {
      "type": "string",
      "description": "Linked Purchase Order number"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "category",
    "amount"
  ]
}