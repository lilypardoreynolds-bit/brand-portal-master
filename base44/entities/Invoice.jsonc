{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "ship_to_name": {
      "type": "string"
    },
    "ship_to_address": {
      "type": "string"
    },
    "ship_to_city": {
      "type": "string"
    },
    "ship_to_state": {
      "type": "string"
    },
    "ship_to_zip": {
      "type": "string"
    },
    "ship_to_country": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Discount amount in dollars"
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Paid",
        "Pending",
        "Overdue",
        "Refunded"
      ],
      "default": "Pending"
    },
    "payment_link": {
      "type": "string",
      "description": "Wise payment link or other payment URL"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment was received"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "transfer",
        "card",
        "cash",
        "check",
        "other"
      ],
      "description": "Payment method used"
    },
    "payment_reference": {
      "type": "string",
      "description": "Payment reference number"
    },
    "payment_transaction_number": {
      "type": "string",
      "description": "Transaction number from payment provider"
    },
    "payment_proof_url": {
      "type": "string",
      "description": "URL of uploaded payment proof screenshot"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "customer_name"
  ]
}