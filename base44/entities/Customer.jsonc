{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "ship_to_address": {
      "type": "string",
      "description": "Shipping address street"
    },
    "ship_to_city": {
      "type": "string"
    },
    "ship_to_state": {
      "type": "string"
    },
    "ship_to_zip": {
      "type": "string"
    },
    "ship_to_country": {
      "type": "string"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "Retail",
        "Wholesale",
        "Distributor"
      ],
      "default": "Retail"
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false
    },
    "tax_exempt_certificate": {
      "type": "string",
      "description": "Tax exemption certificate number"
    },
    "tax_exempt_expiry": {
      "type": "string",
      "format": "date"
    },
    "tax_exempt_file_url": {
      "type": "string",
      "description": "Uploaded tax exempt certificate file URL"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name"
  ]
}